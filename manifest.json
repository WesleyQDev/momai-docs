{
  "id": "momai-docs",
  "name": "MomAI Docs",
  "version": "1.1.0",
  "is_official": true,
  "author": "WesleyQDev",
  "description": "Studio for creating documents, academic papers, letterhead fills, presentations, podcasts, and explainer videos grounded in your sources.",
  "category": "productivity",
  "tags": [
    "documents",
    "presentations",
    "slides",
    "abnt",
    "podcast",
    "video",
    "letterhead",
    "workbook",
    "study",
    "pdf",
    "docx",
    "pptx"
  ],
  "app_icon": "app.png",
  "icon": "icon.svg",
  "sidebar_icon": "icon.svg",
  "sidebar_icon_essential": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"8\" y1=\"13\" x2=\"16\" y2=\"13\"/><line x1=\"8\" y1=\"17\" x2=\"13\" y2=\"17\"/></svg>",
  "theme": {
    "gradient": "from-indigo-600 to-violet-500",
    "accent": "violet"
  },
  "readme": {
    "pt-BR": "README.pt-BR.md",
    "en-US": "README.md",
    "es": "README.es.md",
    "fr": "README.fr.md",
    "de": "README.de.md",
    "it": "README.it.md"
  },
  "locales": {
    "pt-BR": {
      "name": "MomAI Docs",
      "description": "Estúdio de criação de documentos, ABNT, folhas timbradas, apresentações, podcasts e vídeos explicativos fundamentados nas suas fontes.",
      "category": "productivity",
      "tags": ["documentos", "apresentações", "abnt", "podcast", "vídeo", "folha timbrada"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Acesso rápido aos projetos e gerações recentes do MomAI Docs."
        }
      }
    },
    "en-US": {
      "name": "MomAI Docs",
      "description": "Studio for creating documents, academic papers, letterhead fills, presentations, podcasts, and explainer videos grounded in your sources.",
      "category": "productivity",
      "tags": ["documents", "presentations", "podcast", "video", "letterhead", "study"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Quick access to your MomAI Docs projects and recent generations."
        }
      }
    },
    "es": {
      "name": "MomAI Docs",
      "description": "Estudio para crear documentos, presentaciones, podcasts y videos explicativos fundamentados en tus fuentes.",
      "category": "productivity",
      "tags": ["documentos", "presentaciones", "podcast", "video", "membrete", "estudio"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Acceso rápido a los proyectos y generaciones recientes de MomAI Docs."
        }
      }
    },
    "fr": {
      "name": "MomAI Docs",
      "description": "Studio de création de documents, présentations, podcasts et vidéos explicatives fondés sur vos sources.",
      "category": "productivity",
      "tags": ["documents", "présentations", "podcast", "vidéo", "en-tête", "étude"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Accès rapide à vos projets et générations récentes dans MomAI Docs."
        }
      }
    },
    "de": {
      "name": "MomAI Docs",
      "description": "Studio zum Erstellen von Dokumenten, Präsentationen, Podcasts und Erklärvideos auf Basis Ihrer Quellen.",
      "category": "productivity",
      "tags": ["dokumente", "präsentationen", "podcast", "video", "briefkopf", "studium"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Schnellzugriff auf Ihre MomAI Docs-Projekte und letzten Generierungen."
        }
      }
    },
    "it": {
      "name": "MomAI Docs",
      "description": "Studio per creare documenti, presentazioni, podcast e video esplicativi basati sulle tue fonti.",
      "category": "productivity",
      "tags": ["documenti", "presentazioni", "podcast", "video", "carta intestata", "studio"],
      "widgets": {
        "docs-studio": {
          "name": "MomAI Docs",
          "description": "Accesso rapido ai progetti e alle generazioni recenti di MomAI Docs."
        }
      }
    }
  },
  "sdkVersion": 1,
  "momai_compat": ">=1.22.0",
  "sidebar": true,
  "background": true,
  "backgroundScript": "dist/runtime.js",
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write",
    "chat:messages"
  ],
  "storage": {
    "description": "Local projects, indexed sources, vector chunks, generated artifacts, versions, task queue, and brand kits.",
    "locations": ["extension.db", "session-files/*"],
    "sessionFiles": true,
    "collections": [
      {
        "name": "projects",
        "unique": "id",
        "indexes": ["updatedAt", "archived"],
        "textIndex": ["name", "description"]
      },
      {
        "name": "sources",
        "unique": "id",
        "indexes": ["projectId", "status", "contentHash", "kind"],
        "textIndex": ["title", "summary"]
      },
      {
        "name": "chunks",
        "unique": "id",
        "indexes": ["projectId", "sourceId", "chunkIndex"],
        "textIndex": ["text", "sectionTitle"]
      },
      {
        "name": "artifacts",
        "unique": "id",
        "indexes": ["projectId", "toolId", "templateId", "status", "createdAt"],
        "textIndex": ["title", "summary"]
      },
      {
        "name": "artifact_versions",
        "unique": "id",
        "indexes": ["artifactId", "versionNumber"]
      },
      {
        "name": "brand_kits",
        "unique": "id",
        "indexes": ["projectId"]
      },
      {
        "name": "tts_cache",
        "unique": "cacheKey",
        "indexes": ["voice", "engine"],
        "retentionDays": 90
      }
    ]
  },
  "ui": {
    "page": "dist/page.js",
    "pageType": "momai-docs-page",
    "widgets": [
      {
        "id": "docs-studio",
        "name": "MomAI Docs",
        "description": "Quick access to your MomAI Docs projects and recent generations.",
        "entry": "dist/widget-studio.js",
        "type": "momai-docs-studio-widget",
        "defaultSize": "compact_2x1",
        "supportsTransparency": true
      }
    ]
  },
  "routes": [
    { "method": "GET", "path": "/projects", "tool": "docs_route_projects" },
    { "method": "POST", "path": "/projects", "tool": "docs_project_manage" },
    { "method": "GET", "path": "/sources", "tool": "docs_route_sources" },
    { "method": "POST", "path": "/sources", "tool": "docs_source_add" },
    { "method": "POST", "path": "/sources/discover", "tool": "docs_source_discover" },
    { "method": "POST", "path": "/sources/query", "tool": "docs_source_query" },
    { "method": "GET", "path": "/templates", "tool": "docs_templates_list" },
    { "method": "POST", "path": "/templates/preview", "tool": "docs_templates_list" },
    { "method": "POST", "path": "/generate", "tool": "docs_artifact_generate" },
    { "method": "GET", "path": "/artifacts", "tool": "docs_route_artifacts" },
    { "method": "POST", "path": "/refine", "tool": "docs_artifact_refine" },
    { "method": "POST", "path": "/export", "tool": "docs_artifact_export" },
    { "method": "POST", "path": "/brand-kits", "tool": "docs_route_brand_kits" },
    { "method": "GET", "path": "/brand-kits", "tool": "docs_route_brand_kits" },
    { "method": "GET", "path": "/diagnostics", "tool": "docs_route_diagnostics" }
  ],
  "tools": [
    {
      "name": "docs_project_manage",
      "description": "Creates, lists, opens, updates, deletes, exports, or imports isolated MomAI Docs projects (each project maintains its own sources, history, and artifacts).",
      "parameters": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["list", "create", "open", "update", "delete", "auto_title", "export_bundle", "import_bundle"] },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Output language for the project and automatic title" },
          "projectId": { "type": "string", "description": "Project ID" },
          "name": { "type": "string", "description": "Project name (for create/update)" },
          "description": { "type": "string", "description": "Brief project description" },
          "pinned": { "type": "boolean", "description": "Pin project to the top" },
          "titleLocked": { "type": "boolean", "description": "Lock automatic title renaming" },
          "profile": { "type": "string", "enum": ["general", "student", "teacher", "lawyer", "public_servant", "executive"] },
          "groundingMode": { "type": "string", "enum": ["sources_only", "sources_plus_general"] },
          "bundleBase64": { "type": "string", "description": ".momai-docs package in base64 for import_bundle" }
        }
      }
    },
    {
      "name": "docs_source_add",
      "description": "Adds a source of truth to the project (PDF/DOCX/PPTX/XLSX/CSV/TXT/MD/image/audio file, web URL, YouTube link, or pasted text) and runs ingestion and indexing.",
      "parameters": {
        "type": "object",
        "required": ["projectId", "kind"],
        "properties": {
          "projectId": { "type": "string" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Output language for generated titles and summaries" },
          "kind": { "type": "string", "enum": ["file", "url", "youtube", "text", "remove", "toggle_pin", "toggle_active", "sync"] },
          "sourceId": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "fileName": { "type": "string" },
          "mimeType": { "type": "string" },
          "contentBase64": { "type": "string" },
          "text": { "type": "string" },
          "pinned": { "type": "boolean" },
          "active": { "type": "boolean" },
          "deferAutoTitle": { "type": "boolean", "description": "Skip automatic project title update until a batch finishes" }
        }
      }
    },
    {
      "name": "docs_source_discover",
      "description": "Searches the web and YouTube for sources on a topic, classifies reliability, removes duplicates, and returns summarized suggestions for user approval.",
      "parameters": {
        "type": "object",
        "required": ["projectId", "query"],
        "properties": {
          "projectId": { "type": "string" },
          "query": { "type": "string" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Language of source suggestions" },
          "limit": { "type": "number" },
          "includeYouTube": { "type": "boolean" }
        }
      }
    },
    {
      "name": "docs_source_query",
      "description": "Answers a question or retrieves passages from the active project sources using hybrid search (Gemma Embedding + FTS5) with traceable citations.",
      "parameters": {
        "type": "object",
        "required": ["projectId", "query"],
        "properties": {
          "projectId": { "type": "string" },
          "query": { "type": "string" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Language of the response with citations" },
          "limit": { "type": "number" },
          "answerWithCitations": { "type": "boolean" },
          "history": { "type": "array" }
        }
      }
    },
    {
      "name": "docs_templates_list",
      "description": "Lists available tools and templates (including categories, languages, slot schemas, and license information).",
      "parameters": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["list", "render_preview", "analyze_user_template", "save_user_template"] },
          "toolId": { "type": "string" },
          "templateId": { "type": "string" },
          "category": { "type": "string" },
          "query": { "type": "string" },
          "fileName": { "type": "string" },
          "contentBase64": { "type": "string" },
          "name": { "type": "string" },
          "slots": { "type": "array", "items": { "type": "object" } },
          "isBrandMode": { "type": "boolean" },
          "brandKit": { "type": "object" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"] }
        }
      }
    },
    {
      "name": "docs_artifact_generate",
      "description": "Generates a document, presentation, letterhead, podcast, explainer video, spreadsheet, flashcards, or mind map grounded in the project sources.",
      "parameters": {
        "type": "object",
        "required": ["projectId", "toolId"],
        "properties": {
          "projectId": { "type": "string" },
          "toolId": {
            "type": "string",
            "enum": [
              "oficio",
              "apostila",
              "abnt",
              "letterhead",
              "pptx",
              "podcast",
              "video",
              "report",
              "flashcards",
              "mindmap",
              "xlsx",
              "resume",
              "lesson_plan",
              "meeting_minutes",
              "contract",
              "faq",
              "newsletter"
            ]
          },
          "templateId": { "type": "string" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Language of the generated content" },
          "instructions": { "type": "string" },
          "groundingMode": { "type": "string", "enum": ["sources_only", "sources_plus_general"] },
          "letterheadFileBase64": { "type": "string" },
          "letterheadFileName": { "type": "string" },
          "options": { "type": "object" },
          "asyncJob": { "type": "boolean" }
        }
      }
    },
    {
      "name": "docs_artifact_refine",
      "description": "Refines a generated artifact based on instructions (e.g., make it more formal, replace slide 3, expand chapter 2) or reverts to a previous version.",
      "parameters": {
        "type": "object",
        "required": ["artifactId"],
        "properties": {
          "artifactId": { "type": "string" },
          "locale": { "type": "string", "enum": ["pt-BR", "en-US", "es", "fr", "de", "it"], "description": "Language of the refined content" },
          "instruction": { "type": "string" },
          "targetSectionOrSlide": { "type": "string" },
          "revertToVersion": { "type": "number" }
        }
      }
    },
    {
      "name": "docs_artifact_export",
      "description": "Exports a finished artifact in the selected format (docx, pdf, pptx, xlsx, mp3, wav, mp4, srt, csv, anki, svg, png, md, html).",
      "parameters": {
        "type": "object",
        "required": ["artifactId", "format"],
        "properties": {
          "artifactId": { "type": "string" },
          "format": { "type": "string", "enum": ["docx", "pdf", "pptx", "xlsx", "mp3", "wav", "mp4", "srt", "csv", "anki", "svg", "png", "jpg", "md", "html"] }
        }
      }
    }
  ]
}
